nav a {

  text-decoration: none;
  color: white;

  padding: 12px 18px;

  border-radius: 999px;

  background: rgba(255,255,255,.06);

  border: 1px solid rgba(255,255,255,.08);

  transition: .25s ease;

  font-weight: 600;
  font-size: .95rem;

  backdrop-filter: blur(10px);

  cursor: pointer;

}
